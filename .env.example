# === Branding / domain ===
APP_NAME=DocSight AI
# Optional. Empty = general-purpose assistant for any document.
# Set to e.g. "legal contracts" or "scientific papers" to specialise it.
DOMAIN_HINT=

# === LLM (free) ===
# Get a free key at https://console.groq.com — no credit card required
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# === Vector store ===
# Leave QDRANT_URL empty for embedded on-disk Qdrant (local dev only).
# On Render you MUST set this — the filesystem is ephemeral and embedded
# mode holds an exclusive single-process lock.
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME=documents

# === Shared corpus ===
# false = every user only ever sees their own uploads. Keep false for any
# public deployment; true only for a corpus you curated and ingested.
ENABLE_SHARED_CORPUS=false

# === Uploads ===
MAX_UPLOAD_MB=25

# === Storage mode: "local" (default) or "aws" ===
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=./data/uploads
LOCAL_QDRANT_PATH=./data/qdrant

# === API ===
# Comma-separated origins. "*" is fine while testing, tighten before launch.
ALLOWED_ORIGINS=*

# === AWS (only read when STORAGE_MODE=aws) ===
AWS_REGION=ap-south-1
S3_BUCKET=
DYNAMODB_TABLE=

# === MLflow (local, free) ===
MLFLOW_TRACKING_URI=file:./mlruns

# === Session / retention ===
SESSION_TTL_HOURS=24
